{
  "name": "slab-vscode",
  "displayName": "slab",
  "description": "slab language support: syntax highlighting and a language server (diagnostics, hover, go to definition, completion, outline) for .slab programs",
  "version": "0.1.0",
  "author": "HeavyLvy",
  "publisher": "heavylvy",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/HeavyLvy/slab.git" },
  "homepage": "https://github.com/HeavyLvy/slab",
  "bugs": { "url": "https://github.com/HeavyLvy/slab/issues" },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "slab",
        "aliases": [
          "slab",
          "slab"
        ],
        "extensions": [
          ".slab"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "slab",
        "scopeName": "source.slab",
        "path": "./syntaxes/slab.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "slab",
        "path": "./snippets/slab.json"
      }
    ],
    "configuration": {
      "title": "slab",
      "properties": {
        "slab.server.path": {
          "type": "string",
          "default": "",
          "description": "Path of the slab-lsp executable. Empty: uses target/release/slab-lsp in the workspace, then slab-lsp from PATH."
        },
        "slab.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication with slab-lsp."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --target=node18",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --target=node18 --watch",
    "typecheck": "tsc -p . --noEmit",
    "grammar": "cargo run -q -p slab-lsp -- grammar syntaxes",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository",
    "vsix": "npm run package && code --install-extension slab-vscode-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
