{
  "Pack data function": {
    "prefix": "fnload",
    "body": ["#[load]", "fn ${1:name}() {", "\t$0", "}"],
    "description": "A function that runs once when the pack loads"
  },
  "every tick function": {
    "prefix": "fntick",
    "body": ["#[tick]", "fn ${1:name}() {", "\t$0", "}"],
    "description": "A function that runs every tick"
  },
  "every N function": {
    "prefix": "fnevery",
    "body": ["#[every(${1:1s})]", "fn ${2:name}() {", "\t$0", "}"],
    "description": "A function that runs every N (ticks, seconds, days)"
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:field}: ${3:int},", "}"],
    "description": "A struct with one field"
  },
  "let": {
    "prefix": "let",
    "body": ["let ${1:name}: ${2:int} = ${3:0};"],
    "description": "A local variable with a type annotation"
  },
  "for range loop": {
    "prefix": "for",
    "body": ["for ${1:i} in ${2:0}..${3:10} {", "\t$0", "}"],
    "description": "Counting loop"
  },
  "context block": {
    "prefix": "ctx",
    "body": ["as ${1:@a} at ${2:@s} {", "\t$0", "}"],
    "description": "An execute-style context block (as/at)"
  }
}