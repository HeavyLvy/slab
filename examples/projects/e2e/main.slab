// End-to-end test project: every result lands in a global that tools/verify_pack.py reads back
// from the running game (see checks.json).
import mathx;
import game::arena;
import mathx::{Pair, square};

objective pts = "dummy";

global r_fib: int = 0;
global r_clamp_hi: int = 0;
global r_clamp_lo: int = 0;
global r_loop_break: int = 0;
global r_for_jump: int = 0;
global r_fact: int = 0;
global r_for_list: int = 0;
global r_nested: int = 0;
global r_first_square: int = 0;
global r_cond_call: int = 0;
global r_div: int = 0;
global r_mod: int = 0;
global r_compound: int = 0;
global r_logic: int = 0;
global r_score: int = 0;
global r_struct_ret: int = 0;
global r_list_sum: int = 0;
global r_dynlist: int = 0;
global r_len: int = 0;
global r_recur_data: int = 0;
global r_even: int = 0;
global r_shadow: int = 0;
global r_arena: int = 0;
global r_arena_len: int = 0;
global r_pair: int = 0;
global ticks: int = 0;
global every_count: int = 0;
global loaded: int = 0;
global r_dyn_index: int = 0;
global r_dyn_struct: int = 0;
global r_dyn_loop: int = 0;
global r_dyn_neg: int = 0;
global r_ent_distinct: int = 0;
global r_ent_alive: int = 0;
global r_ent_after_kill: int = 0;
global r_ent_stale_tp: int = 0;
global r_ent_same: int = 0;
global r_ent_ctx: int = 0;
global r_ent_score: int = 0;
global r_ent_list: int = 0;
global r_ent_fn: int = 0;
global r_ent_struct: int = 0;
global r_for_ent: int = 0;
global r_for_moved: int = 0;
global r_for_score: int = 0;
global r_str_cat: str = "";
global r_str_tag: int = 0;
global r_str_tag_n: int = 0;
global r_results: int = 0;
global r_gone: int = 0;
global r_entities: int = 0;
global r_exists: int = 0;
global r_tagged: int = 0;
global greeting: str = "unset";
global names: list<str> = [];

#[load]
fn run_all() {
    loaded += 1;
    names = [];

    r_fib = mathx::fib(10);
    r_clamp_hi = mathx::clamp(100, 0, 50);
    r_clamp_lo = mathx::clamp(-5, 0, 50);
    r_even = mathx::is_even(10) * 10 + mathx::is_even(7);

    // loop with break and continue: odd numbers up to 20, stopping after 15
    let mut i = 0;
    let mut s = 0;
    loop {
        i += 1;
        if i > 20 { break; }
        if i % 2 == 0 { continue; }
        if i > 15 { break; }
        s += i;
    }
    r_loop_break = s;

    // for with continue and break: 0+1+2+4+5+6
    let mut t = 0;
    for k in 0..10 {
        if k == 3 { continue; }
        if k == 7 { break; }
        t += k;
    }
    r_for_jump = t;

    // inclusive range, 5!
    let mut p = 1;
    for k in 1..=5 { p *= k; }
    r_fact = p;

    // for over lists, including an early break
    let mut ls = 0;
    for x in [3, 4, 5] { ls += x; }
    let mut cnt = 0;
    for name in ["ann", "bob", "cy", "dee"] {
        if name.len() > 2 { cnt += 1; }
        if cnt == 2 { break; }
    }
    r_for_list = ls * 100 + cnt;

    // nested loops: break only leaves the inner one
    let mut n = 0;
    for _a in 0..4 {
        for b in 0..4 {
            if b == 2 { break; }
            n += 1;
        }
    }
    r_nested = n;

    r_first_square = first_square_over(50);

    // a call in the loop condition is re-evaluated each iteration
    let mut c = 0;
    while mathx::lt(c, 5) { c += 1; }
    r_cond_call = c;

    // floored division and modulo (runtime values, not folded)
    let mut a = -7;
    let b = 2;
    r_div = a / b;
    r_mod = a % b;
    a *= 3;
    a /= 2;
    a %= 7;
    r_compound = a;

    // boolean logic
    let x = 3;
    let y = 7;
    let mut l = 0;
    if x < 5 && y > 5 || x == 100 { l += 1; }
    if !(x < 5 && y > 5) { l += 10; }
    if x != 3 || y != 7 { l += 100; }
    r_logic = l;

    // scoreboard objective with fake players
    pts["#alice"] = 5;
    pts["#alice"] += 3;
    pts["#bob"] = pts["#alice"] * 2;
    r_score = pts["#alice"] + pts["#bob"];

    // structs: returned from calls, field of a call result
    r_struct_ret = mathx::make_pair(3, 4).b;
    let pr = mathx::make_pair(5, 6);
    r_pair = pr.a * 10 + pr.b + square(2);

    // lists: dynamic literal, push, len, constant indices
    let base = 10;
    let mut xs = [base, base + 1, base * 2];
    xs.push(99);
    r_list_sum = xs[0] + xs[1] + xs[2] + xs[3];
    r_len = xs.len();
    let words = ["x", "yy"];
    r_dynlist = words.len() * 100 + names.len();

    // strings through calls
    greeting = echo("hello");
    names.push(greeting);
    names.push("world");

    // data parameters survive recursion
    r_recur_data = count_chars(3, "ab");

    // shadowing
    let sh = 1;
    {
        let sh = sh + 1;
        r_shadow = sh;
    }
    r_shadow = r_shadow * 10 + sh;

    // variable list indices (a macro under the hood): read, write, compound assignment, expression index
    let mut ys = [10, 20, 30, 40];
    let ix = 2;
    ys[ix] = 99;
    ys[ix - 1] += 5;
    r_dyn_index = ys[ix] + ys[ix - 1] * 1000 + ys[ix + 1] * 1000000;

    // an element that is a struct: read and update one of its fields
    let mut ps = [mathx::make_pair(1, 2), mathx::make_pair(3, 4)];
    let j = 1;
    ps[j].a += 10;
    r_dyn_struct = ps[j].a * 100 + ps[0].b;

    // a loop over a list by index, and a negative index counting from the end
    let zs = [1, 2, 3, 4, 5];
    let mut zk = 0;
    let mut zt = 0;
    while zk < zs.len() {
        zt += zs[zk];
        zk += 1;
    }
    r_dyn_loop = zt;
    let neg = 0 - 1;
    r_dyn_neg = zs[neg];

    // f-strings: text with embedded values (numbers, strings, lists, struct fields, expressions)
    print(f"fib={r_fib} greeting={greeting} names={names} pair={pr.a},{pr.b} sum={ys[ix] + 1} {{braces}}");

    // another module's globals and structs
    arena::reset();
    arena::advance();
    arena::advance();
    r_arena = arena::seconds * 100 + arena::round_number();
    r_arena_len = arena::scores_len();
}

fn echo(s: str) -> str {
    return s;
}

// every call needs the previous result and the label to survive the recursive call
fn count_chars(n: int, label: str) -> int {
    if n == 0 { return 0; }
    let before = label.len();
    let rest = count_chars(n - 1, label);
    return rest + before;
}

fn first_square_over(limit: int) -> int {
    for i in 0..1000 {
        if i * i > limit { return i; }
    }
    return -1;
}

#[tick]
fn step() {
    ticks += 1;
}

#[every(10)]
fn tenth() {
    every_count += 1;
}

// Not an entry point: the harness runs it with `/function e2e:world_test`.
fn world_test() {
    // explicit coordinates: the console runs at the world spawn, which differs per world, so
    // "here" may not be in the chunk the harness force-loads (chunk 0 0)
    kill(@e[type=minecraft:marker]);
    summon("minecraft:marker", 8, 64, 8);
    summon("minecraft:marker", 8, 64, 8);
    summon("minecraft:marker", 8, 64, 8);

    let mut n = 0;
    as @e[type=minecraft:marker] { n += 1; }
    r_entities = n;

    if exists(@e[type=minecraft:marker]) { r_exists = 1; }

    as @e[type=minecraft:marker, limit=2] { tag.add(@s, "seen"); }
    let mut t = 0;
    as @e[type=minecraft:marker] at @s {
        if tag.has(@s, "seen") { t += 1; }
    }
    r_tagged = t;
    kill(@e[type=minecraft:marker]);

    // variable coordinates: blocks and a context block positioned by variables
    let level = 1;
    let bx = 4 * 2;
    setblock(bx, 64 + level, bx, "minecraft:gold_block");
    positioned bx 64 bx {
        setblock(~, ~2, ~, "minecraft:diamond_block");
    }

    entity_test();
    string_test();

    // one owned entity is left alive on purpose: `_uninstall` must remove it
    summon("minecraft:marker", bx, 64, bx);
    // ...and moved with variable coordinates
    let ty = 70;
    tp(@e[tag=e2e.owned, limit=1], bx, ty, bx);

    // command results: did the command work? (the value is only computed because it is used)
    let ok1 = tp(@e[tag=e2e.owned, limit=1], bx, ty, bx);        // a marker exists (macro helper)
    let ok2 = tp(@e[tag=nobody, limit=1], 1, 2, 3);              // nothing matches
    let ok3 = tp(@e[tag=nobody, limit=1], bx, ty, bx);           // nothing matches (macro helper)
    let ok4 = tag.add(@e[tag=e2e.owned, limit=1], "mark");       // first time
    let ok5 = tag.add(@e[tag=e2e.owned, limit=1], "mark");       // already has it
    let ok6 = kill(@e[tag=nobody]);                              // nothing to kill
    let ok7 = setblock(bx, 80, bx, "minecraft:stone");           // changes the block
    let ok8 = setblock(bx, 80, bx, "minecraft:stone");           // already stone
    let mut res = 0;
    if ok1 { res += 1; }
    if ok2 { res += 2; }
    if ok3 { res += 4; }
    if ok4 { res += 8; }
    if ok5 { res += 16; }
    if ok6 { res += 32; }
    if ok7 { res += 64; }
    if ok8 { res += 128; }
    r_results = res;
    // a failure can be caught: a missing target takes the other branch
    if !tp(@e[tag=nobody, limit=1], 0, 0, 0) { r_gone = 1; }

    // variable effect duration (ticks) and amplifier; nobody is online, but the command must parse
    let secs = 3;
    effect.give(@a, "minecraft:speed", secs * 20, level);
}

struct Duel {
    left: entity,
    right: entity,
}

fn raise(e: entity, y: int) -> bool {
    return tp(e, 8, y, 8);
}

fn spawn_at(x: int) -> entity {
    return summon("minecraft:marker", x, 64, 8);
}

// Entity values: a variable holds an entity and acts on it. Run by the harness after world_test.
// Strings: joining, f-strings as values, and strings chosen at run time as command arguments.
fn string_test() {
    let kind = "mark";
    let n = 7;
    let mut s = "a-" + kind;
    s += f"-{n}";
    r_str_cat = s;

    // an entity type, a tag name and a block id built at run time
    let ty = "marker";
    let m = summon("minecraft:" + ty, 14, 64, 14);
    if tag.add(m, f"t_{n}") { r_str_tag = 1; }
    let mut c = 0;
    as @e[type=minecraft:marker, tag=t_7] { c += 1; }
    r_str_tag_n = c;
    let mat = "emerald";
    setblock(14, 63, 14, "minecraft:" + mat + "_block");
    say(f"string test done, n = {n}");
    kill(m);
}

fn entity_test() {
    let a = summon("minecraft:marker", 8, 64, 8);
    let b = summon("minecraft:marker", 9, 64, 9);
    if a != b && exists(a) && exists(b) { r_ent_distinct = 1; }

    // act on exactly one of them: only `a` moves
    raise(a, 90);
    let mut up = 0;
    as @e[type=minecraft:marker, x=8.5, y=90, z=8.5, distance=..0.5] { up += 1; }
    r_ent_alive = up;

    // a selector for one entity gives the same handle again (the id is stable)
    let again = @e[type=minecraft:marker, x=8.5, y=90, z=8.5, distance=..0.5, limit=1];
    if again == a { r_ent_same = 1; }

    // handles through a function, a list and a struct
    let c = spawn_at(12);
    let hs = [a, b, c];
    let mut n = 0;
    for h in hs { if tag.add(h, "listed") { n += 1; } }
    r_ent_list = n;
    let duel = Duel { left: a, right: c };
    r_ent_struct = 0;
    if exists(duel.left) && exists(duel.right) && duel.left != duel.right { r_ent_struct = 1; }
    if raise(c, 70) { r_ent_fn = 1; }

    // a context block over a handle, and a score on an entity
    let mut seen = 0;
    as b { seen += 1; }
    r_ent_ctx = seen;
    pts["#e"] = 0;
    pts[b] = 5;
    pts[b] += 3;
    r_ent_score = pts[b];

    // `for` over a selector: one entity at a time, with the match bound as an entity
    let d = summon("minecraft:marker", 10, 64, 10);
    let q = summon("minecraft:marker", 11, 64, 11);
    tag.add(d, "forz");
    tag.add(q, "forz");
    let mut n = 0;
    for z in @e[tag=forz] {
        n += 1;
        tp(z, 0, 90, 0);            // the named entity moves, not @s
        pts[z] = 7;                 // and carries its own score
    }
    r_for_ent = n;
    let mut standing = 0;
    as @e[type=minecraft:marker, x=0.5, y=90, z=0.5, distance=..0.5] { standing += 1; }
    r_for_moved = standing;
    let first = @e[type=minecraft:marker, x=0.5, y=90, z=0.5, distance=..0.5, limit=1];
    if pts[first] == 7 { r_for_score = 7; }

    // kill one: its handle goes stale and every action on it fails (catchable)
    kill(b);
    if !exists(b) { r_ent_after_kill = 1; }
    if !tp(b, 0, 70, 0) { r_ent_stale_tp = 1; }

    kill(a);
    kill(c);
    kill(d);
    kill(q);
}
