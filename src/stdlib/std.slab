//! The standard library that has nothing to do with Minecraft.
//!
//! This file is part of the compiler: `slab` loads it like any other module. A function
//! without a body and marked `#[intrinsic("name")]` is implemented by the compiler itself,
//! which turns the call into the Minecraft commands it needs (see `docs/lang/stdlib.md`).

/// Show a message to every player with `tellraw`. It accepts any value; an f-string is shown
/// part by part (numbers and text keep their natural form), so `print(f"hp = {hp}")` just works.
#[intrinsic("print")]
pub fn print(value: any);

/// A value that may be missing: `Some(x)` has one, `None` does not. `Option`, `Some` and `None`
/// are in scope everywhere. The type argument cannot always be guessed: write
/// `let x: Option<int> = None;`.
pub enum Option<T> {
    None,
    Some(T),
}

/// The outcome of something that can fail: `Ok(x)` worked and carries a result, `Err(e)` did not
/// and carries a reason. `Result`, `Ok` and `Err` are in scope everywhere.
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T> Option<T> {
    /// Whether this is `Some`.
    #[intrinsic("option.is_some")]
    pub fn is_some(self) -> bool;

    /// Whether this is `None`.
    #[intrinsic("option.is_none")]
    pub fn is_none(self) -> bool;

    /// The value inside `Some`. On `None` there is nothing to give: the players are told
    /// (`slab: unwrap on None (main.slab:12)` in chat), the pack is stopped when the program was
    /// built with `--abort-on-unwrap`, and the function returns (inside a context block, which
    /// cannot be left, it carries on with a zero value instead).
    #[intrinsic("option.unwrap")]
    pub fn unwrap(self) -> T;

    /// The value inside `Some`, or `default` for `None`. `default` is always evaluated.
    #[intrinsic("option.unwrap_or")]
    pub fn unwrap_or(self, default: T) -> T;

    /// Like `unwrap`, with your own message instead of "unwrap on None".
    #[intrinsic("option.expect")]
    pub fn expect(self, message: str) -> T;
}

impl<T, E> Result<T, E> {
    /// Whether this is `Ok`.
    #[intrinsic("result.is_ok")]
    pub fn is_ok(self) -> bool;

    /// Whether this is `Err`.
    #[intrinsic("result.is_err")]
    pub fn is_err(self) -> bool;

    /// The value inside `Ok`. On `Err` it behaves like `Option::unwrap` on `None`.
    #[intrinsic("result.unwrap")]
    pub fn unwrap(self) -> T;

    /// The value inside `Ok`, or `default` for `Err`. `default` is always evaluated.
    #[intrinsic("result.unwrap_or")]
    pub fn unwrap_or(self, default: T) -> T;

    /// Like `unwrap`, with your own message instead of "unwrap on Err".
    #[intrinsic("result.expect")]
    pub fn expect(self, message: str) -> T;

    /// `Some(value)` for `Ok(value)`, `None` for `Err`.
    #[intrinsic("result.ok")]
    pub fn ok(self) -> Option<T>;

    /// `Some(error)` for `Err(error)`, `None` for `Ok`.
    #[intrinsic("result.err")]
    pub fn err(self) -> Option<E>;
}

// ---------------------------------------------------------------------------------------------
// Fixed-point numbers. Minecraft's scoreboard only holds 32-bit integers, so a number with a
// fraction is two integers: `whole` (rounded down, so -6.5 is whole -7 and frac 5000) and `frac`,
// the digits after the point. Which type to use is a question of how the number gets into the
// program; see docs/lang/doubles.md for the measurements behind the two types.
//
// Literals (`1.5`) and operators (`a + b`, `a < b`, `-a`) work on both: `a + b` calls `a.add(b)`.
// ---------------------------------------------------------------------------------------------

/// A number with 4 decimals, read from the world with no help: `data get` with a scale. Exact
/// for coordinates within 21,474 blocks of the origin; further out the world gives no more
/// digits, so `position_near` fails there. All the arithmetic lives here, because the products
/// fit in 32 bits inside that range.
#[decimals(4)]
pub struct NearDouble {
    whole: int,
    frac: int,
}

/// A number with 6 decimals, read through a scratch marker entity, which keeps the digits
/// anywhere in the world (up to the border at 29,999,984). It needs the chunk at 0 0 loaded and
/// costs about ten commands per read. Add, subtract and compare here; multiply after converting
/// with `to_near`, because a product of big numbers does not fit in 32 bits.
#[decimals(6)]
pub struct FarDouble {
    whole: int,
    frac: int,
}

impl NearDouble {
    /// A whole number.
    pub fn from_int(n: int) -> NearDouble {
        return NearDouble { whole: n, frac: 0 };
    }

    /// The number of ten-thousandths: `NearDouble::from_units(-65000)` is -6.5.
    pub fn from_units(units: int) -> NearDouble {
        return NearDouble { whole: units / 10000, frac: units % 10000 };
    }

    /// The number in ten-thousandths (within 214,748 blocks, so it fits an `int`).
    pub fn units(self) -> int {
        return self.whole * 10000 + self.frac;
    }

    /// Rounded down to a whole number.
    pub fn floor(self) -> int {
        return self.whole;
    }

    /// The same number with 6 decimals.
    pub fn to_far(self) -> FarDouble {
        return FarDouble { whole: self.whole, frac: self.frac * 100 };
    }

    pub fn add(self, other: NearDouble) -> NearDouble {
        return NearDouble::from_units(self.units() + other.units());
    }

    pub fn sub(self, other: NearDouble) -> NearDouble {
        return NearDouble::from_units(self.units() - other.units());
    }

    pub fn neg(self) -> NearDouble {
        return NearDouble::from_units(0 - self.units());
    }

    /// Product, cut off after the fourth decimal. Exact while the result is within 214,748.
    pub fn mul(self, other: NearDouble) -> NearDouble {
        let cross = self.whole * other.frac + other.whole * self.frac + self.frac * other.frac / 10000;
        return NearDouble { whole: self.whole * other.whole + cross / 10000, frac: cross % 10000 };
    }

    /// Quotient by a whole number, cut off after the fourth decimal.
    pub fn div_int(self, by: int) -> NearDouble {
        return NearDouble::from_units(self.units() / by);
    }

    pub fn lt(self, other: NearDouble) -> bool {
        return self.units() < other.units();
    }

    pub fn le(self, other: NearDouble) -> bool {
        return self.units() <= other.units();
    }

    pub fn gt(self, other: NearDouble) -> bool {
        return self.units() > other.units();
    }

    pub fn ge(self, other: NearDouble) -> bool {
        return self.units() >= other.units();
    }

    /// The text Minecraft reads as this number: `-6.0005`. Written out in one function with the
    /// common case (not negative) first, because it runs for every number put into a command.
    pub fn text(self) -> str {
        let w = self.whole;
        let f = self.frac;
        if w >= 0 {
            if f >= 1000 { return f"{w}.{f}"; }
            if f >= 100 { return f"{w}.0{f}"; }
            if f >= 10 { return f"{w}.00{f}"; }
            return f"{w}.000{f}";
        }
        return decimal_text(w, f, 10000);
    }
}

impl FarDouble {
    /// A whole number.
    pub fn from_int(n: int) -> FarDouble {
        return FarDouble { whole: n, frac: 0 };
    }

    /// Rounded down to a whole number.
    pub fn floor(self) -> int {
        return self.whole;
    }

    /// Rounded to 4 decimals. Only meaningful within 21,474 blocks of the origin.
    pub fn to_near(self) -> NearDouble {
        let units = (self.frac + 50) / 100;
        return NearDouble { whole: self.whole + units / 10000, frac: units % 10000 };
    }

    pub fn add(self, other: FarDouble) -> FarDouble {
        let sum = self.frac + other.frac;
        return FarDouble { whole: self.whole + other.whole + sum / 1000000, frac: sum % 1000000 };
    }

    pub fn sub(self, other: FarDouble) -> FarDouble {
        let diff = self.frac - other.frac;
        return FarDouble { whole: self.whole - other.whole + diff / 1000000, frac: diff % 1000000 };
    }

    pub fn neg(self) -> FarDouble {
        return FarDouble { whole: 0, frac: 0 }.sub(self);
    }

    pub fn lt(self, other: FarDouble) -> bool {
        if self.whole != other.whole { return self.whole < other.whole; }
        return self.frac < other.frac;
    }

    pub fn le(self, other: FarDouble) -> bool {
        if self.whole != other.whole { return self.whole < other.whole; }
        return self.frac <= other.frac;
    }

    pub fn gt(self, other: FarDouble) -> bool {
        if self.whole != other.whole { return self.whole > other.whole; }
        return self.frac > other.frac;
    }

    pub fn ge(self, other: FarDouble) -> bool {
        if self.whole != other.whole { return self.whole > other.whole; }
        return self.frac >= other.frac;
    }

    /// The text Minecraft reads as this number: `29999984.567800`.
    pub fn text(self) -> str {
        return decimal_text(self.whole, self.frac, 1000000);
    }
}

/// `whole + frac / scale` as Minecraft writes numbers: a sign, the whole part of the absolute
/// value, a point, and the fraction with its leading zeros (`-6.0005`, not `-7` and `.5`).
/// `scale` is 10000 or 1000000. No loops and few calls: this runs for every number written
/// into a command, and a tick may run only 65,536 commands.
fn decimal_text(whole: int, frac: int, scale: int) -> str {
    if whole >= 0 {
        if scale == 10000 { return text4("", whole, frac); }
        return text6("", whole, frac);
    }
    // below zero the game wants the sign and the absolute value: -6.5 is `-6.5`, not `-7` and `.5`
    if frac > 0 {
        if scale == 10000 { return text4("-", 0 - whole - 1, scale - frac); }
        return text6("-", 0 - whole - 1, scale - frac);
    }
    if scale == 10000 { return text4("-", 0 - whole, 0); }
    return text6("-", 0 - whole, 0);
}

/// `sign`, `whole`, a point and four digits: `frac` is 0 to 9999 and keeps its leading zeros.
fn text4(sign: str, whole: int, frac: int) -> str {
    if frac >= 1000 { return f"{sign}{whole}.{frac}"; }
    if frac >= 100 { return f"{sign}{whole}.0{frac}"; }
    if frac >= 10 { return f"{sign}{whole}.00{frac}"; }
    return f"{sign}{whole}.000{frac}";
}

/// The same with six digits.
fn text6(sign: str, whole: int, frac: int) -> str {
    if frac >= 100000 { return f"{sign}{whole}.{frac}"; }
    if frac >= 10000 { return f"{sign}{whole}.0{frac}"; }
    if frac >= 1000 { return f"{sign}{whole}.00{frac}"; }
    if frac >= 100 { return f"{sign}{whole}.000{frac}"; }
    if frac >= 10 { return f"{sign}{whole}.0000{frac}"; }
    return f"{sign}{whole}.00000{frac}";
}
