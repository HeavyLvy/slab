{
  "name": "slab-vscode",
  "displayName": "slab",
  "description": "Language support for slab, the language that compiles to Minecraft data packs: highlighting, diagnostics, hover, completion, go to definition, formatting.",
  "icon": "images/icon.png",
  "galleryBanner": { "color": "#16213a", "theme": "dark" },
  "preview": true,
  "keywords": ["slab", "minecraft", "datapack", "data pack", "mcfunction", "language server"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace the language server is only taken from the extension itself or your PATH, never from the workspace's build folder, and slab.server.path is ignored.",
      "restrictedConfigurations": ["slab.server.path"]
    }
  },
  "version": "0.1.0",
  "author": "HeavyLvy",
  "publisher": "HeavyLvy",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/HeavyLvy/slab.git" },
  "homepage": "https://github.com/HeavyLvy/slab",
  "bugs": { "url": "https://github.com/HeavyLvy/slab/issues" },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "slab",
        "aliases": [
          "slab",
          "slab"
        ],
        "extensions": [
          ".slab"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "slab",
        "scopeName": "source.slab",
        "path": "./syntaxes/slab.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "slab",
        "path": "./snippets/slab.json"
      }
    ],
    "configuration": {
      "title": "slab",
      "properties": {
        "slab.server.path": {
          "type": "string",
          "default": "",
          "description": "Path of the slab-lsp executable. Empty: the server bundled with the extension, then target/release/slab-lsp of a trusted workspace, then slab-lsp from ~/.cargo/bin and PATH."
        },
        "slab.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication with slab-lsp."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --target=node18",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --target=node18 --watch",
    "typecheck": "tsc -p . --noEmit",
    "grammar": "cargo run -q -p slab-lsp -- grammar syntaxes",
    "package": "npm run compile && vsce package --no-dependencies",
    "package:target": "npm run compile && vsce package --no-dependencies --target",
    "vsix": "npm run package && code --install-extension \"$(ls -t slab-vscode-*.vsix | head -n 1)\""
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
