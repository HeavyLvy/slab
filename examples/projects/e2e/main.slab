#[load]
fn run_all() {
    loaded += 1;
    names = [];

    r_fib = mathx::fib(10);
    r_clamp_hi = mathx::clamp(100, 0, 50);
    r_clamp_lo = mathx::clamp(-5, 0, 50);
    r_even = mathx::is_even(10) * 10 + mathx::is_even(7);

    // loop with break and continue: odd numbers up to 20, stopping after 15
    let mut i = 0;
    let mut s = 0;
    loop {
        i += 1;
        if i > 20 { break; }
        if i % 2 == 0 { continue; }
        if i > 15 { break; }
        s += i;
    }
    r_loop_break = s;

    // for with continue and break: 0+1+2+4+5+6
    let mut t = 0;
    for k in 0..10 {
        if k == 3 { continue; }
        if k == 7 { break; }
        t += k;
    }
    r_for_jump = t;

    // inclusive range, 5!
    let mut p = 1;
    for k in 1..=5 { p *= k; }
    r_fact = p;

    // for over lists, including an early break
    let mut ls = 0;
    for x in [3, 4, 5] { ls += x; }
    let mut cnt = 0;
    for name in ["ann", "bob", "cy", "dee"] {
        if name.len() > 2 { cnt += 1; }
        if cnt == 2 { break; }
    }
    r_for_list = ls * 100 + cnt;

    // nested loops: break only leaves the inner one
    let mut n = 0;
    for _a in 0..4 {
        for b in 0..4 {
            if b == 2 { break; }
            n += 1;
        }
    }
    r_nested = n;

    r_first_square = first_square_over(50);

    // a call in the loop condition is re-evaluated each iteration
    let mut c = 0;
    while mathx::lt(c, 5) { c += 1; }
    r_cond_call = c;

    // floored division and modulo (runtime values, not folded)
    let mut a = -7;
    let b = 2;
    r_div = a / b;
    r_mod = a % b;
    a *= 3;
    a /= 2;
    a %= 7;
    r_compound = a;

    // boolean logic
    let x = 3;
    let y = 7;
    let mut l = 0;
    if x < 5 && y > 5 || x == 100 { l += 1; }
    if !(x < 5 && y > 5) { l += 10; }
    if x != 3 || y != 7 { l += 100; }
    r_logic = l;

    // scoreboard objective with fake players
    pts["#alice"] = 5;
    pts["#alice"] += 3;
    pts["#bob"] = pts["#alice"] * 2;
    r_score = pts["#alice"] + pts["#bob"];

    // structs: returned from calls, field of a call result
    r_struct_ret = mathx::make_pair(3, 4).b;
    let pr = mathx::make_pair(5, 6);
    r_pair = pr.a * 10 + pr.b + square(2);

    // lists: dynamic literal, push, len, constant indices
    let base = 10;
    let mut xs = [base, base + 1, base * 2];
    xs.push(99);
    r_list_sum = xs[0] + xs[1] + xs[2] + xs[3];
    r_len = xs.len();
    let words = ["x", "yy"];
    r_dynlist = words.len() * 100 + names.len();

    // strings through calls
    greeting = echo("hello");
    names.push(greeting);
    names.push("world");

    // data parameters survive recursion
    r_recur_data = count_chars(3, "ab");

    // shadowing
    let sh = 1;
    {
        let sh = sh + 1;
        r_shadow = sh;
    }
    r_shadow = r_shadow * 10 + sh;

    // variable list indices (a macro under the hood): read, write, compound assignment, expression index
    let mut ys = [10, 20, 30, 40];
    let ix = 2;
    ys[ix] = 99;
    ys[ix - 1] += 5;
    r_dyn_index = ys[ix] + ys[ix - 1] * 1000 + ys[ix + 1] * 1000000;

    // an element that is a struct: read and update one of its fields
    let mut ps = [mathx::make_pair(1, 2), mathx::make_pair(3, 4)];
    let j = 1;
    ps[j].a += 10;
    r_dyn_struct = ps[j].a * 100 + ps[0].b;

    // a loop over a list by index, and a negative index counting from the end
    let zs = [1, 2, 3, 4, 5];
    let mut zk = 0;
    let mut zt = 0;
    while zk < zs.len() {
        zt += zs[zk];
        zk += 1;
    }
    r_dyn_loop = zt;
    let neg = 0 - 1;
    r_dyn_neg = zs[neg];

    // f-strings: text with embedded values (numbers, strings, lists, struct fields, expressions)
    print(f"fib={r_fib} greeting={greeting} names={names} pair={pr.a},{pr.b} sum={ys[ix] + 1} {{braces}}");

    // another module's globals and structs
    arena::reset();
    arena::advance();
    arena::advance();
    r_arena = arena::seconds * 100 + arena::round_number();
    r_arena_len = arena::scores_len();
}

fn echo(s: str) -> str {
    return s;
}

// every call needs the previous result and the label to survive the recursive call
fn count_chars(n: int, label: str) -> int {
    if n == 0 { return 0; }
    let before = label.len();
    let rest = count_chars(n - 1, label);
    return rest + before;
}

fn first_square_over(limit: int) -> int {
    for i in 0..1000 {
        if i * i > limit { return i; }
    }
    return -1;
}

#[tick]
fn step() {
    ticks += 1;
}

#[every(10)]
fn tenth() {
    every_count += 1;
}

// Not an entry point: the harness runs it with `/function e2e:world_test`.
fn world_test() {
    // explicit coordinates: the console runs at the world spawn, which differs per world, so
    // "here" may not be in the chunk the harness force-loads (chunk 0 0)
    kill(@e[type=minecraft:marker]);
    summon("minecraft:marker", 8, 64, 8);
    summon("minecraft:marker", 8, 64, 8);
    summon("minecraft:marker", 8, 64, 8);

    let mut n = 0;
    as @e[type=minecraft:marker] { n += 1; }
    r_entities = n;

    if exists(@e[type=minecraft:marker]) { r_exists = 1; }

    as @e[type=minecraft:marker, limit=2] { tag::add(@s, "seen"); }
    let mut t = 0;
    as @e[type=minecraft:marker] at @s {
        if tag::has(@s, "seen") { t += 1; }
    }
    r_tagged = t;
    kill(@e[type=minecraft:marker]);

    // variable coordinates: blocks and a context block positioned by variables
    let level = 1;
    let bx = 4 * 2;
    setblock(bx, 64 + level, bx, "minecraft:gold_block");
    positioned bx 64 bx {
        setblock(~, ~2, ~, "minecraft:diamond_block");
    }

    entity_test();
    string_test();
    selector_test();
    equality_test();
    enum_test();
    impl_test();
    command_test();

    // one owned entity is left alive on purpose: `_uninstall` must remove it
    summon("minecraft:marker", bx, 64, bx);
    // ...and moved with variable coordinates
    let ty = 70;
    tp(@e[tag=e2e.owned, limit=1], bx, ty, bx);

    // command results: did the command work? (the value is only computed because it is used)
    let ok1 = tp(@e[tag=e2e.owned, limit=1], bx, ty, bx);        // a marker exists (macro helper)
    let ok2 = tp(@e[tag=nobody, limit=1], 1, 2, 3);              // nothing matches
    let ok3 = tp(@e[tag=nobody, limit=1], bx, ty, bx);           // nothing matches (macro helper)
    let ok4 = tag::add(@e[tag=e2e.owned, limit=1], "mark");       // first time
    let ok5 = tag::add(@e[tag=e2e.owned, limit=1], "mark");       // already has it
    let ok6 = kill(@e[tag=nobody]);                              // nothing to kill
    let ok7 = setblock(bx, 80, bx, "minecraft:sea_lantern");           // changes the block (a block the terrain never has: the world seed is random)
    let ok8 = setblock(bx, 80, bx, "minecraft:sea_lantern");           // already that block
    let mut res = 0;
    if ok1 { res += 1; }
    if ok2 { res += 2; }
    if ok3 { res += 4; }
    if ok4 { res += 8; }
    if ok5 { res += 16; }
    if ok6 { res += 32; }
    if ok7 { res += 64; }
    if ok8 { res += 128; }
    r_results = res;
    // a failure can be caught: a missing target takes the other branch
    if !tp(@e[tag=nobody, limit=1], 0, 0, 0) { r_gone = 1; }

    // variable effect duration (ticks) and amplifier; nobody is online, but the command must parse
    let secs = 3;
    effect::give(@a, "minecraft:speed", secs * 20, level);
}

struct Duel {
    left: EntityId,
    right: EntityId,
}

fn raise(e: EntityId, y: int) -> bool {
    return tp(e, 8, y, 8);
}

fn spawn_at(x: int) -> EntityId {
    return summon("minecraft:marker", x, 64, 8);
}

// EntityId values: a variable holds an entity and acts on it. Run by the harness after world_test.
struct Pair2 { a: int, name: str, tags: list<str> }

fn eq_str(a: str, b: str) -> bool { return a == b; }

enum Shape { Dot, Line(int, int), Named(str, list<int>) }

struct Holder { name: str, maybe: Option<int> }

fn pick(flag: bool, n: int) -> Option<int> {
    if flag { return Some(n + 1); }
    return None;
}

fn outcome(ok: bool) -> Result<(), str> {
    if ok { return Ok(()); }
    return Err("boom");
}

// Enums: building values, passing and returning them, storing them in globals, lists and structs.
fn enum_test() {
    let a: Option<int> = None;
    if a == None { r_enum_none = 1; }
    let n = 4;
    let b = Some(n + 1);
    if b == Some(5) { r_enum_some = 1; }
    if Some(1) != Some(2) && b != a && Some(1) != None { r_enum_ne = 1; }
    if pick(true, 1) == Some(2) { r_enum_ret_some = 1; }
    if pick(false, 1) == None { r_enum_ret_none = 1; }
    if outcome(true) == Ok(()) { r_enum_ok_unit = 1; }
    let bad = outcome(false);
    if bad == Err("boom") && bad != Err("other") && bad != Ok(()) { r_enum_err = 1; }

    if enum_start == Some(7) { r_enum_global_init = 1; }
    enum_slot = Some(n + 1);
    if enum_slot == Some(5) && enum_slot != None { r_enum_global_set = 1; }

    let xs = [Some(1), None, Some(3)];
    if xs == [Some(1), None, Some(3)] && xs != [Some(1), None, Some(4)] { r_enum_list = 1; }
    let h = Holder { name: "h", maybe: Some(n) };
    let h2 = Holder { name: "h", maybe: None };
    if h.maybe == Some(4) && h != h2 { r_enum_field = 1; }

    let s = Shape::Line(1, n);
    if s == Shape::Line(1, 4) && s != Shape::Dot && s != Shape::Line(1, 5) && Shape::Dot == Shape::Dot { r_enum_user = 1; }
    let named = Shape::Named("x", [n, 2]);
    if named == Shape::Named("x", [4, 2]) && named != Shape::Named("x", [4]) { r_enum_payload = 1; }
    let nested: Option<Option<int>> = Some(Some(n));
    if nested == Some(Some(4)) && nested != Some(None) { r_enum_nested = 1; }
}

struct Counter { n: int, label: str }

impl Counter {
    fn new(label: str) -> Counter { return Counter { n: 0, label: label }; }
    fn bumped(self, by: int) -> Counter { return Counter { n: self.n + by, label: self.label }; }
    fn total(self) -> int { return self.n; }
    fn describe(self) -> str { return f"{self.label}={self.n}"; }
}

enum Dir { North, East }

impl Dir {
    pub fn turn(self) -> Self { if self == Dir::North { return Dir::East; } return Self::North; }
    fn is_north(self) -> bool { return self == Dir::North; }
}

fn unwrap_flow(o: Option<int>) -> int {
    let v = o.unwrap();
    r_impl_unwrap_reached += 1;
    return v + 100;
}

// Methods (`impl`), and the methods of Option and Result.
fn impl_test() {
    let c = Counter::new("c").bumped(2).bumped(3);
    r_impl_struct = c.total();
    if c.describe() == "c=5" { r_impl_str = 1; }
    r_impl_assoc = Counter::total(c);
    let d = Dir::North;
    let east = d.turn();
    let back = east.turn();
    let back_north = back.is_north();
    if east == Dir::East && back_north { r_impl_enum = 1; }

    let some = Some(4);
    let none: Option<int> = None;
    if some.is_some() && none.is_none() && !some.is_none() && !none.is_some() { r_impl_opt_is = 1; }
    r_impl_opt_unwrap = some.unwrap();
    r_impl_opt_or = none.unwrap_or(7) + some.unwrap_or(7);

    let ok: Result<int, str> = Ok(3);
    let bad: Result<int, str> = Err("no");
    if ok.is_ok() && bad.is_err() && !ok.is_err() && !bad.is_ok() { r_impl_res_is = 1; }
    r_impl_res_or = bad.unwrap_or(0 - 1) + ok.unwrap_or(0);
    if ok.ok() == Some(3) && bad.ok() == None && bad.err() == Some("no") && ok.err() == None { r_impl_res_conv = 1; }
    r_impl_expect = ok.expect("must be ok");

    // a failed unwrap says so in chat and returns from the function: nothing after it runs
    r_impl_unwrap_none = unwrap_flow(none);
    r_impl_unwrap_some = unwrap_flow(some);
}

// `run_command`: a command written as text, with the outcome as a `Result<int, ()>`.
fn command_test() {
    run_command("scoreboard players set #cmd e2e 41");
    let r = run_command("scoreboard players get #cmd e2e");
    r_cmd_value = r.unwrap_or(0 - 1);
    if r.is_ok() { r_cmd_ok = 1; }
    // a command that fails is an Err, whatever its text
    let bad = run_command("scoreboard players get #nobody e2e");
    if bad.is_err() { r_cmd_err = 1; }
    // text computed at run time
    let n = 7;
    run_command(f"scoreboard players set #cmd e2e {n}");
    let dynamic = run_command(f"scoreboard players get #cmd e2e");
    r_cmd_dynamic = dynamic.unwrap_or(0 - 1);
    // a success with the result 0 is still Ok
    run_command("scoreboard players set #cmd e2e 0");
    let zero = run_command("scoreboard players get #cmd e2e");
    if zero.is_ok() && zero.unwrap_or(5) == 0 { r_cmd_zero = 1; }
}

// `==` / `!=` on strings, lists, structs, and an entity against a selector.
fn equality_test() {
    if eq_str("abc", "abc") { r_eq_str_eq = 1; }
    if !eq_str("abc", "abd") { r_eq_str_ne = 1; }
    let part = "b";
    if "a" + part + "c" == "abc" { r_eq_str_calc = 1; }

    let xs = [1, 2, 3];
    if xs == [1, 2, 3] { r_eq_list_eq = 1; }
    if xs != [3, 2, 1] && xs != [1, 2] && xs != [1, 2, 4] { r_eq_list_ne = 1; }
    let empty: list<int> = [];
    if empty == [] && empty != xs { r_eq_list_len = 1; }

    let p = Pair2 { a: 1, name: "n", tags: ["x", "y"] };
    let mut q = Pair2 { a: 1, name: "n", tags: ["x", "y"] };
    if p == q { r_eq_struct_eq = 1; }
    q.tags.push("z");
    if p != q { r_eq_struct_ne = 1; }

    // a stored string against a literal is one `if data` test
    let hello = "hello";
    if hello == "hello" { r_eq_lit_eq = 1; }
    if hello != "world" && !(hello == "world") && "hello" == hello { r_eq_lit_ne = 1; }
    if p.name == "n" && p.name != "m" { r_eq_lit_field = 1; }
    if eq_text == "glob" && eq_text != "other" { r_eq_lit_global = 1; }
    let tricky = "q\"\\$(x)'s";
    if tricky == "q\"\\$(x)'s" && tricky != "q\"\\$(y)'s" { r_eq_lit_special = 1; }
    let names = ["a", "b"];
    if names[1] == "b" && names[0] != "b" { r_eq_lit_elem = 1; }

    // ||, && and a loop condition re-evaluate the comparison each time
    let s = "x";
    if s == "no" || s != "yes" { r_eq_or = 1; }
    let mut grown = "";
    let mut n = 0;
    while grown != "aaa" { grown += "a"; n += 1; }
    r_eq_loop = n;

    // an entity and a selector for one entity
    let m1 = summon("minecraft:marker", 6, 64, 6);
    let m2 = summon("minecraft:marker", 7, 64, 6);
    tag::add(m1, "eq1");
    tag::add(m2, "eq2");
    if m1 == @e[tag=eq1, limit=1] && @e[tag=eq1, limit=1] == m1 { r_eq_entity = 1; }
    if m2 != @e[tag=eq1, limit=1] && m1 != m2 && !(m1 == m2) { r_eq_entity_other = 1; }
    if @e[tag=eq1, limit=1] == @e[tag=eq1, limit=1] && @e[tag=eq1, limit=1] != @e[tag=eq2, limit=1] { r_eq_selector = 1; }
    let pairs = [m1, m2];
    let other = [m1, m2];
    if pairs == other && pairs != [m2, m1] { r_eq_nested = 1; }
    kill(m1);
    kill(m2);
}

// Selector options chosen at run time: `$name` and `${expr}` inside `@e[...]`.
fn selector_test() {
    // three markers, all tagged "seltest"; two of them also "dyn"
    let m1 = summon("minecraft:marker", 2, 64, 2);
    let m2 = summon("minecraft:marker", 3, 64, 2);
    let m3 = summon("minecraft:marker", 14, 64, 14);
    for m in [m1, m2, m3] { tag::add(m, "seltest"); }
    let t = "dyn";
    tag::add(m1, t);
    tag::add(m3, t);
    pts[m1] = 5;
    pts[m2] = 9;

    let near = 2;
    let far = 10;
    let lo = 6;
    let five = 5;
    let n = 2;
    let ty = "minecraft:marker";

    let mut c = 0;
    for _ in @e[tag=seltest, tag=$t] { c += 1; }
    r_sel_tag = c;                       // m1, m3
    c = 0;
    for _ in @e[tag=seltest, tag=!$t] { c += 1; }
    r_sel_ntag = c;                      // m2
    c = 0;
    for _ in @e[tag=seltest, x=2, y=64, z=2, distance=..${near}] { c += 1; }
    r_sel_dist = c;                      // m1, m2
    c = 0;
    for _ in @e[tag=seltest, x=2, y=64, z=2, distance=$far..] { c += 1; }
    r_sel_far = c;                       // m3
    c = 0;
    for _ in @e[tag=seltest, scores={pts=$lo..}] { c += 1; }
    r_sel_lo = c;                        // m2
    c = 0;
    for _ in @e[tag=seltest, scores={pts=$five}] { c += 1; }
    r_sel_exact = c;                     // m1
    c = 0;
    for _ in @e[tag=seltest, limit=$n] { c += 1; }
    r_sel_limit2 = c;
    c = 0;
    for _ in @e[tag=seltest, limit=${n - 1}] { c += 1; }
    r_sel_limit1 = c;
    c = 0;
    for _ in @e[tag=seltest, type=$ty] { c += 1; }
    r_sel_type = c;                      // all three
    c = 0;
    for _ in @e[tag=seltest, type=!$ty] { c += 1; }
    r_sel_ntype = c;                     // none

    // a selector with a variable can become an entity, and works as a target
    let picked: EntityId = @e[tag=seltest, tag=$t, limit=1];
    tag::add(picked, "picked");
    r_sel_picked = 0;
    if exists(@e[tag=picked]) { r_sel_picked = 1; }

    for e in @e[tag=seltest] { kill(e); }
    r_sel_gone = 1;
    if exists(@e[tag=seltest]) { r_sel_gone = 0; }
}

// Strings: joining, f-strings as values, and strings chosen at run time as command arguments.
fn string_test() {
    let kind = "mark";
    let n = 7;
    let mut s = "a-" + kind;
    s += f"-{n}";
    r_str_cat = s;

    // an entity type, a tag name and a block id built at run time
    let ty = "marker";
    let m = summon("minecraft:" + ty, 14, 64, 14);
    if tag::add(m, f"t_{n}") { r_str_tag = 1; }
    let mut c = 0;
    as @e[type=minecraft:marker, tag=t_7] { c += 1; }
    r_str_tag_n = c;
    let mat = "emerald";
    setblock(14, 63, 14, "minecraft:" + mat + "_block");
    game::say(f"string test done, n = {n}");
    kill(m);
}

fn entity_test() {
    let a = summon("minecraft:marker", 8, 64, 8);
    let b = summon("minecraft:marker", 9, 64, 9);
    if a != b && exists(a) && exists(b) { r_ent_distinct = 1; }

    // act on exactly one of them: only `a` moves
    raise(a, 90);
    let mut up = 0;
    as @e[type=minecraft:marker, x=8.5, y=90, z=8.5, distance=..0.5] { up += 1; }
    r_ent_alive = up;

    // a selector for one entity gives the same handle again (the id is stable)
    let again = @e[type=minecraft:marker, x=8.5, y=90, z=8.5, distance=..0.5, limit=1];
    if again == a { r_ent_same = 1; }

    // handles through a function, a list and a struct
    let c = spawn_at(12);
    let hs = [a, b, c];
    let mut n = 0;
    for h in hs { if tag::add(h, "listed") { n += 1; } }
    r_ent_list = n;
    let duel = Duel { left: a, right: c };
    r_ent_struct = 0;
    if exists(duel.left) && exists(duel.right) && duel.left != duel.right { r_ent_struct = 1; }
    if raise(c, 70) { r_ent_fn = 1; }

    // a context block over a handle, and a score on an entity
    let mut seen = 0;
    as b { seen += 1; }
    r_ent_ctx = seen;
    pts["#e"] = 0;
    pts[b] = 5;
    pts[b] += 3;
    r_ent_score = pts[b];

    // `for` over a selector: one entity at a time, with the match bound as an entity
    let d = summon("minecraft:marker", 10, 64, 10);
    let q = summon("minecraft:marker", 11, 64, 11);
    tag::add(d, "forz");
    tag::add(q, "forz");
    let mut n = 0;
    for z in @e[tag=forz] {
        n += 1;
        tp(z, 0, 90, 0);            // the named entity moves, not @s
        pts[z] = 7;                 // and carries its own score
    }
    r_for_ent = n;
    let mut standing = 0;
    as @e[type=minecraft:marker, x=0.5, y=90, z=0.5, distance=..0.5] { standing += 1; }
    r_for_moved = standing;
    let first = @e[type=minecraft:marker, x=0.5, y=90, z=0.5, distance=..0.5, limit=1];
    if pts[first] == 7 { r_for_score = 7; }

    // kill one: its handle goes stale and every action on it fails (catchable)
    kill(b);
    if !exists(b) { r_ent_after_kill = 1; }
    if !tp(b, 0, 70, 0) { r_ent_stale_tp = 1; }

    // `EntityId` methods are written in slab (game.slab) over `run_command`: the position of an
    // entity. The chunk 0 0 is the only one loaded; the entity is moved to a fractional position
    // below ground with a command written as text, and the y is rounded down (-20.25 -> -21).
    let m = summon("minecraft:marker", 7, 80, 9);
    let moved = run_command(f"tp {m.selector()} 5.5 -20.25 9.5");
    let place = m.position();
    if place.is_ok() {
        let v = place.unwrap();
        r_pos_x = v.x;
        r_pos_y = v.y;
        r_pos_z = v.z;
    }
    let snap = m.fetch();
    if snap.is_ok() {
        let entity = snap.unwrap();
        if entity.pos.z == 9 && entity.id == m { r_pos_fetch = 1; }
    }
    if m.is_alive() { r_pos_alive = 1; }
    let sel_text = m.selector();
    let hit = run_command(f"execute if entity {sel_text}");
    if hit.is_ok() { r_pos_sel = 1; }
    kill(m);
    let after = m.position();
    let alive = m.is_alive();
    if after.is_err() && !alive { r_pos_gone = 1; }

    kill(a);
    kill(c);
    kill(d);
    kill(q);
}
